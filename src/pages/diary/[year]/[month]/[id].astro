---
import { LinkPresets } from "@constants/link-presets";
import { LinkPreset } from "@/types/config";
import { moments, sortedMoments } from "@/utils/diary";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";
import ImageWrapper from "@components/common/imageWrapper.astro";
import { Icon } from "astro-icon/components";


export function getStaticPaths() {
    return sortedMoments.map((m, i) => {
        const d = new Date(m.date);
        const year = d.getFullYear().toString();
        const month = (d.getMonth() + 1).toString().padStart(2, '0');
        return {
            params: { year, month, id: m.id },
            props: {
                moment: m,
                prevMoment: i < sortedMoments.length - 1 ? sortedMoments[i + 1] : null,
                nextMoment: i > 0 ? sortedMoments[i - 1] : null,
            },
        };
    });
}

const { moment, prevMoment, nextMoment } = Astro.props;
const pageTitle = moment.title || moment.id;

function getMomentLabel(m: typeof moment) {
    if (m.title) return m.title;
    const text = m.content.replace(/\s+/g, ' ').trim();
    return text.length > 30 ? text.slice(0, 30) + '…' : text;
}

function formatDateTime(dateString: string): string {
    const d = new Date(dateString);
    const y = d.getFullYear();
    const mo = d.getMonth() + 1;
    const day = d.getDate();
    const h = d.getHours().toString().padStart(2, '0');
    const min = d.getMinutes().toString().padStart(2, '0');
    return `${y}年${mo}月${day}日 ${h}:${min}`;
}

function diaryUrl(m: typeof moment): string {
    const d = new Date(m.date);
    const year = d.getFullYear();
    const month = (d.getMonth() + 1).toString().padStart(2, '0');
    return `/diary/${year}/${month}/${m.id}/`;
}

const pageDescription = LinkPresets[LinkPreset.Diary].description;
---

<GridLayout title={pageTitle} description={pageDescription}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-4 py-4 md:px-6 md:py-5 relative w-full">
            <BackwardButton href="/diary/" text="返回 日记" />
            <div class="relative max-w-4xl">
                <div class="moment-detail card-base p-4 md:p-6 lg:p-8">
                    <p class="moment-text text-sm md:text-base lg:text-lg text-90 leading-relaxed mb-4">{moment.content}</p>
                    {moment.images && moment.images.length > 0 && (
                        <div class="moment-images flex flex-wrap gap-2 md:gap-3 mb-4">
                            {moment.images.map((image) => (
                                <ImageWrapper
                                    src={image}
                                    basePath={moment.basePath}
                                    alt={i18n(I18nKey.diaryImage)}
                                    class="w-auto h-auto max-h-[300px] md:max-h-[400px] object-contain rounded-md"
                                />
                            ))}
                        </div>
                    )}
                    <div class="moment-footer flex items-center gap-2 text-75 text-sm">
                        <span>{formatDateTime(moment.date)}</span>
                    </div>
                </div>
            </div>

            <!-- 上一篇 / 下一篇导航 -->
            <div class="flex flex-col md:flex-row justify-between mt-4 gap-4 overflow-hidden w-full">
                <a
                    href={nextMoment ? diaryUrl(nextMoment) : "#"}
                    class:list={[
                        "w-full font-bold overflow-hidden active:scale-95",
                        { "pointer-events-none opacity-0": !nextMoment },
                    ]}
                >
                    {nextMoment && (
                        <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-start! gap-4">
                            <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-(--primary)" />
                            <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
                                {getMomentLabel(nextMoment)}
                            </div>
                        </div>
                    )}
                </a>
                <a
                    href={prevMoment ? diaryUrl(prevMoment) : "#"}
                    class:list={[
                        "w-full font-bold overflow-hidden active:scale-95",
                        { "pointer-events-none opacity-0": !prevMoment },
                    ]}
                >
                    {prevMoment && (
                        <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-end! gap-4">
                            <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
                                {getMomentLabel(prevMoment)}
                            </div>
                            <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-(--primary)" />
                        </div>
                    )}
                </a>
            </div>
        </div>
    </div>
</GridLayout>

<style>
    .card-base {
        background: var(--card-bg);
        border: 1px solid var(--line-divider);
        transition: all 0.3s ease;
    }
    .moment-text { white-space: pre-line; }
</style>
